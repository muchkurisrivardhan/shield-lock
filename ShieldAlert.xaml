<!-- Full-screen "UNAUTHORIZED ACCESS" alert. Embedded in ShieldLock.exe and loaded by Program.cs. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="S.H.I.E.L.D. - Unauthorized Access" WindowStyle="None" ResizeMode="NoResize"
        WindowState="Maximized" Topmost="True" ShowInTaskbar="False" Background="#080000">
  <Window.Resources>
    <SolidColorBrush x:Key="Red" Color="#FF2A2A"/>
    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="Text" Value="UNAUTHORIZED ACCESS"/>
      <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="92"/>
    </Style>
  </Window.Resources>

  <Window.Triggers>
    <EventTrigger RoutedEvent="Window.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <!-- entry: fade + settle -->
          <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
          <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" From="1.08" To="1" Duration="0:0:0.5"/>
          <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" From="1.08" To="1" Duration="0:0:0.5"/>
          <!-- rings -->
          <DoubleAnimation Storyboard.TargetName="Ring1" Storyboard.TargetProperty="Angle" By="360" Duration="0:0:9" RepeatBehavior="Forever"/>
          <DoubleAnimation Storyboard.TargetName="Ring2" Storyboard.TargetProperty="Angle" By="-360" Duration="0:0:6" RepeatBehavior="Forever"/>
          <DoubleAnimation Storyboard.TargetName="Ring3" Storyboard.TargetProperty="Angle" By="360" Duration="0:0:4" RepeatBehavior="Forever"/>
          <!-- 1 Hz pulse, well under the 3 flashes/sec photosensitivity limit -->
          <DoubleAnimation Storyboard.TargetName="Vignette" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever"/>
          <!-- glitch: offset copies of the title, clipped to jumping slices (each changes ~3x/sec) -->
          <RectAnimationUsingKeyFrames Storyboard.TargetName="SliceA" Storyboard.TargetProperty="Rect" Duration="0:0:1.2" RepeatBehavior="Forever">
            <DiscreteRectKeyFrame KeyTime="0:0:0" Value="0,12,2000,23"/>
            <DiscreteRectKeyFrame KeyTime="0:0:0.3" Value="0,70,2000,35"/>
            <DiscreteRectKeyFrame KeyTime="0:0:0.6" Value="0,35,2000,29"/>
            <DiscreteRectKeyFrame KeyTime="0:0:0.9" Value="0,93,2000,21"/>
          </RectAnimationUsingKeyFrames>
          <RectAnimationUsingKeyFrames Storyboard.TargetName="SliceB" Storyboard.TargetProperty="Rect" Duration="0:0:1.2" BeginTime="0:0:0.15" RepeatBehavior="Forever">
            <DiscreteRectKeyFrame KeyTime="0:0:0" Value="0,64,2000,52"/>
            <DiscreteRectKeyFrame KeyTime="0:0:0.3" Value="0,0,2000,20"/>
            <DiscreteRectKeyFrame KeyTime="0:0:0.6" Value="0,46,2000,18"/>
            <DiscreteRectKeyFrame KeyTime="0:0:0.9" Value="0,82,2000,30"/>
          </RectAnimationUsingKeyFrames>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>

  <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform><ScaleTransform x:Name="RootScale"/></Grid.RenderTransform>
    <Grid.Background>
      <RadialGradientBrush RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#3A0000" Offset="0"/>
        <GradientStop Color="#080000" Offset="1"/>
      </RadialGradientBrush>
    </Grid.Background>

    <!-- fixed-size layout scaled to any screen; fixed Width so typing doesn't rescale it -->
    <Viewbox Margin="100">
      <StackPanel Width="1150">
        <Grid Width="200" Height="200">
          <Ellipse Width="184" Height="184" Stroke="{StaticResource Red}" StrokeThickness="4" StrokeDashArray="10 3" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><RotateTransform x:Name="Ring1"/></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Width="152" Height="152" Stroke="{StaticResource Red}" StrokeThickness="2" StrokeDashArray="2 3" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><RotateTransform x:Name="Ring2"/></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Width="120" Height="120" Stroke="{StaticResource Red}" StrokeThickness="6" StrokeDashArray="15 5" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><RotateTransform x:Name="Ring3"/></Ellipse.RenderTransform>
          </Ellipse>
          <Path Stroke="{StaticResource Red}" StrokeThickness="6" StrokeLineJoin="Round" Data="M100,66 L134,126 L66,126 Z"/>
          <Rectangle Fill="{StaticResource Red}" Width="6" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="97,84,0,0"/>
          <Rectangle Fill="{StaticResource Red}" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="97,112,0,0"/>
        </Grid>

        <Grid HorizontalAlignment="Center" Margin="0,28,0,0">
          <TextBlock Style="{StaticResource Title}" Foreground="{StaticResource Red}">
            <TextBlock.Effect><DropShadowEffect Color="#FF2A2A" BlurRadius="30" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect>
          </TextBlock>
          <TextBlock Style="{StaticResource Title}" Foreground="#8C00FFFF">
            <TextBlock.RenderTransform><TranslateTransform X="-4"/></TextBlock.RenderTransform>
            <TextBlock.Clip><RectangleGeometry x:Name="SliceA" Rect="0,12,2000,23"/></TextBlock.Clip>
          </TextBlock>
          <TextBlock Style="{StaticResource Title}" Foreground="#73FFFFFF">
            <TextBlock.RenderTransform><TranslateTransform X="4"/></TextBlock.RenderTransform>
            <TextBlock.Clip><RectangleGeometry x:Name="SliceB" Rect="0,64,2000,52"/></TextBlock.Clip>
          </TextBlock>
        </Grid>

        <TextBlock Text="ACCESS DENIED  //  SECURITY PROTOCOL ENGAGED" HorizontalAlignment="Center" Margin="0,6,0,0"
                   FontFamily="Bahnschrift, Segoe UI" FontSize="22" Foreground="{StaticResource Red}" Opacity="0.8"/>

        <TextBlock x:Name="Log" Width="760" Height="200" Margin="0,36,0,0" HorizontalAlignment="Center"
                   FontFamily="Cascadia Mono, Consolas" FontSize="21" LineHeight="32" LineStackingStrategy="BlockLineHeight"
                   TextWrapping="Wrap" Foreground="#FF8A8A"/>
      </StackPanel>
    </Viewbox>

    <TextBlock Text="PRESS ANY KEY TO DISMISS" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
               FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="{StaticResource Red}" Opacity="0.5"/>

    <!-- CRT scanlines: 2px dark / 2px clear, tiled -->
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,4" MappingMode="Absolute" SpreadMethod="Repeat">
          <GradientStop Color="#59000000" Offset="0"/>
          <GradientStop Color="#59000000" Offset="0.5"/>
          <GradientStop Color="#00000000" Offset="0.5"/>
          <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <Rectangle x:Name="Vignette" IsHitTestVisible="False">
      <Rectangle.Fill>
        <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
          <GradientStop Color="#00FF0000" Offset="0.55"/>
          <GradientStop Color="#A6FF0000" Offset="1"/>
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
  </Grid>
</Window>
